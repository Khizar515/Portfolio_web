# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=database
DB_PORT=3306
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
DB_USER=portfolio_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=portfolio_db

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret

# ── Domains (Cloudflare Zero Trust Tunnel on Azure) ───────────────────────────
FRONTEND_URL=https://khizar.ksdev.me
NEXT_PUBLIC_API_URL=https://api.khizar.ksdev.me/api

# Local development — uncomment and comment out the lines above

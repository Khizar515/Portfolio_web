# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=database
DB_PORT=3306
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
DB_USER=portfolio_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=portfolio_db

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret

# ── Domains (Cloudflare Zero Trust Tunnel on Azure) ───────────────────────────
FRONTEND_URL=https://khizar.ksdev.me
# NEXT_PUBLIC_API_URL=https://api.khizar.ksdev.me/api
# NOTE: NEXT_PUBLIC_API_URL is no longer set here.
# It is hardcoded as '/api' in docker-compose.yml build args so the browser
# calls khizar.ksdev.me/api/* and Next.js rewrites proxy it to the backend.
# For local development, set it to http://localhost:5000/api in your local .env

# Local development — uncomment these and comment out FRONTEND_URL above
# FRONTEND_URL=http://localhost:3000

# Local development — uncomment and comment out the lines above
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ============================================================
# Portfolio Web — Root .gitignore
# Stack: Next.js (frontend) | Node.js (backend) | MySQL | Docker
# ============================================================

# ─────────────────────────────────────────
# 🔐 Environment & Secrets  (NEVER push these)
# ─────────────────────────────────────────
.env
.env.*
!.env.example          # keep the example template

# ─────────────────────────────────────────
# 📦 Node / npm dependencies
# ─────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# ─────────────────────────────────────────
# ⚡ Next.js build outputs
# ─────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ─────────────────────────────────────────
# 🗄️ Database — local data volumes & dumps
# ─────────────────────────────────────────
database/data/
database/*.sql.bak
*.sql.dump
mysql-data/
pgdata/

# ─────────────────────────────────────────
# 🐳 Docker — generated / override files
# ─────────────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml
.dockerignore.local

# ─────────────────────────────────────────
# 📤 Backend — file uploads & exports
# ─────────────────────────────────────────
backend/uploads/
backend/exports/
backend/logs/
logs/
*.log

# ─────────────────────────────────────────
# 🧪 Testing & Coverage
# ─────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
*.lcov

# ─────────────────────────────────────────
# 🔑 Certificates & Keys
# ─────────────────────────────────────────
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
ssl/

# ─────────────────────────────────────────
# 🖥️ OS generated files
# ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─────────────────────────────────────────
# 🛠️ IDEs & Editors
# ─────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/

# ─────────────────────────────────────────
# 📝 Temporary & Misc
# ─────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.cache
.cache/
dist/
